# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno de MAGNÉTIC (CLAUDE.md §11.1).
# Copia este archivo a `.env` y completa los valores. Nunca commitear `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Base de datos — Supabase (PostgreSQL)
#  DATABASE_URL: pooler de transacciones (puerto 6543) — runtime / serverless.
#  DIRECT_URL:   conexión directa (puerto 5432) — migraciones.
#  En Supabase: Connect → ORM. Reemplaza [REF], [PASSWORD] y [REGION].
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"

# Auth.js
AUTH_SECRET="..."              # generar con: npx auth secret
AUTH_URL="http://localhost:3000"

# Supabase Storage (imágenes subidas desde el admin)
#  SUPABASE_URL: https://[REF].supabase.co
#  SERVICE_ROLE_KEY: Settings → API → service_role (¡secreta! solo servidor)
#  BUCKET: nombre del bucket PÚBLICO de Storage
SUPABASE_URL="https://[REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="..."
SUPABASE_STORAGE_BUCKET="uploads"

# Izipay (obtener del panel de comercio Izipay)
IZIPAY_MERCHANT_ID="..."       # Identificador de tienda
IZIPAY_API_KEY_TEST="..."      # Clave API de prueba
IZIPAY_API_KEY_PROD="..."      # Clave API de producción
IZIPAY_PUBLIC_KEY="..."        # Clave pública para el navegador
IZIPAY_HMAC_KEY="..."          # Clave HMAC para validar transacciones
IZIPAY_ENV="test"              # test | production

# Email
EMAIL_FROM="..."
RESEND_API_KEY="..."           # si se usa Resend
ADMIN_NOTIFICATION_EMAIL="..." # bandeja del negocio: avisos de contacto y reclamos

# Cron (Vercel Cron / llamada manual): protege /api/cron/cleanup
CRON_SECRET="..."              # generar con: openssl rand -hex 24

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
